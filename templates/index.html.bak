<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover" />
    <title>Haven · Revenue Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>

    <!-- App styles -->
    <link rel="stylesheet" href="/static/css/base.css">
    <link rel="stylesheet" href="/static/css/layout.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/calendar.css">
</head>
<body>

    <!-- ═══ LOGIN ═══ -->
    <div id="loginPage">
        <div class="login-card">
            <div class="login-logo">
                <div class="icon">💰</div>
                <h1>Haven</h1>
                <p>Revenue &amp; Expense Manager</p>
            </div>
            <div id="loginError" class="error-box"></div>
            <form id="loginForm">
                <div class="field">
                    <label>Username</label>
                    <input type="text" id="username" value="admin" autocomplete="username">
                </div>
                <div class="field">
                    <label>Password</label>
                    <input type="password" id="password" value="admin123" autocomplete="current-password">
                </div>
                <button type="submit" class="btn-primary"><i class="fas fa-sign-in-alt" style="margin-right:10px"></i>Sign In</button>
            </form>
            <p class="login-hint">Demo: admin / admin123</p>
        </div>
    </div>

    <!-- ═══ APP ═══ -->
    <div id="appPage">
        <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

        <!-- Sidebar -->
        <div id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <div class="icon-sm">💰</div>
                    <span>Haven</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <button class="nav-item active" id="snav-dashboard" onclick="switchTab('dashboard'); closeSidebar()">
                    <i class="fas fa-th-large"></i> Dashboard
                </button>
                <button class="nav-item" id="snav-sales" onclick="switchTab('sales'); closeSidebar()">
                    <i class="fas fa-shopping-cart"></i> Sales
                </button>
                <button class="nav-item" id="snav-expenses" onclick="switchTab('expenses'); closeSidebar()">
                    <i class="fas fa-receipt"></i> Expenses
                </button>
                <button class="nav-item" id="snav-credits" onclick="switchTab('credits'); closeSidebar()">
                    <i class="fas fa-hand-holding-usd"></i> Credits
                </button>
                <button class="nav-item" id="snav-reports" onclick="switchTab('reports'); closeSidebar()">
                    <i class="fas fa-chart-bar"></i> Reports
                </button>
                <button class="nav-item" id="snav-calendar" onclick="switchTab('calendar'); closeSidebar()">
                    <i class="fas fa-calendar-alt"></i> Calendar
                </button>
            </nav>
            <div class="sidebar-footer">
                <div class="user-row">
                    <span class="user-name" id="userName">User</span>
                    <button class="btn-logout" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </div>
            </div>
        </div>

        <!-- Main -->
        <div class="main-wrap" id="mainWrap">
            <!-- mobile header -->
            <div class="mobile-header">
                <button class="menu-btn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <span class="logo-text">💰 Haven</span>
                <span class="user-chip" id="userNameMobile">User</span>
            </div>

            <!-- Dashboard -->
            <div id="dashboardTab" class="tab-content active">
                <div class="page-header">
                    <h2>Dashboard</h2>
                    <p>Today's overview</p>
                </div>

                <div class="stats-grid">
                    <div class="stat-card blue">
                        <div class="stat-label">Today's Revenue</div>
                        <div class="stat-value blue" id="todayRevenue">$0</div>
                        <div class="stat-sub">Net: <span id="todayNet">$0</span></div>
                        <i class="fas fa-arrow-trend-up stat-icon"></i>
                    </div>
                    <div class="stat-card amber">
                        <div class="stat-label">Today's Credit</div>
                        <div class="stat-value amber" id="todaysCredit">$0</div>
                        <div class="stat-sub">Pending today</div>
                        <i class="fas fa-hand-holding-usd stat-icon"></i>
                    </div>
                    <div class="stat-card amber">
                        <div class="stat-label">Pending Credits</div>
                        <div class="stat-value amber" id="pendingCredits">$0</div>
                        <div class="stat-sub">Total owed</div>
                        <i class="fas fa-clock stat-icon"></i>
                    </div>
                    <div class="stat-card red">
                        <div class="stat-label">Today's Expenses</div>
                        <div class="stat-value red" id="todayExpenses">$0</div>
                        <div class="stat-sub">Profit: <span id="todayProfit">$0</span></div>
                        <i class="fas fa-receipt stat-icon"></i>
                    </div>
                    <div class="stat-card green">
                        <div class="stat-label">Sales Today</div>
                        <div class="stat-value green" id="todaySalesCount">0</div>
                        <div class="stat-sub">Need: <span id="salesNeeded">0</span> more</div>
                        <i class="fas fa-chart-line stat-icon"></i>
                    </div>
                </div>

                <div class="quick-actions">
                    <button class="action-btn blue" onclick="switchTab('sales'); setTimeout(openSaleModal,100)">
                        <i class="fas fa-plus-circle"></i>New Sale
                    </button>
                    <button class="action-btn red" onclick="switchTab('expenses'); setTimeout(openExpenseModal,100)">
                        <i class="fas fa-plus-circle"></i>Add Expense
                    </button>
                    <button class="action-btn amber" onclick="switchTab('credits')">
                        <i class="fas fa-hand-holding-usd"></i>View Credits
                    </button>
                </div>
            </div>

            <!-- Sales -->
            <div id="salesTab" class="tab-content">
                <div class="page-header-row">
                    <div>
                        <h2 style="font-size:22px;font-weight:800;">Sales</h2>
                        <p style="font-size:13px;color:var(--text-2);">Manage your sales</p>
                    </div>
                    <button class="btn btn-blue" onclick="openSaleModal()"><i class="fas fa-plus"></i> New Sale</button>
                </div>

                <!-- Filter Bar -->
                <div class="search-row" style="flex-wrap:wrap; gap:8px;">
                    <input type="text" id="salesItemFilter" placeholder="Filter by item name…" style="flex:1; min-width:150px;" oninput="loadSalesSummary()">
                    <input type="date" id="salesStartDate" style="width:auto; min-width:130px;" onchange="loadSalesSummary()">
                    <input type="date" id="salesEndDate" style="width:auto; min-width:130px;" onchange="loadSalesSummary()">
                    <button class="search-btn" onclick="loadSalesSummary()"><i class="fas fa-search"></i> Filter</button>
                    <button class="search-btn" style="background:var(--text-3);" onclick="clearSalesFilters()"><i class="fas fa-undo"></i> Reset</button>
                </div>

                <!-- Summary Cards -->
                <div class="stats-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom:14px;">
                    <div class="stat-card blue">
                        <div class="stat-label">Total Sales</div>
                        <div class="stat-value blue" id="salesSummaryCount">0</div>
                        <div class="stat-sub">Transactions</div>
                        <i class="fas fa-shopping-cart stat-icon"></i>
                    </div>
                    <div class="stat-card green">
                        <div class="stat-label">Total Revenue</div>
                        <div class="stat-value green" id="salesSummaryRevenue">$0</div>
                        <div class="stat-sub">Net: <span id="salesSummaryNet">$0</span></div>
                        <i class="fas fa-dollar-sign stat-icon"></i>
                    </div>
                    <div class="stat-card amber">
                        <div class="stat-label">Total Credit</div>
                        <div class="stat-value amber" id="salesSummaryCredit">$0</div>
                        <div class="stat-sub">Unpaid</div>
                        <i class="fas fa-hand-holding-usd stat-icon"></i>
                    </div>
                    <div class="stat-card red">
                        <div class="stat-label">Items Sold</div>
                        <div class="stat-value red" id="salesSummaryItems">0</div>
                        <div class="stat-sub">Unique items</div>
                        <i class="fas fa-boxes stat-icon"></i>
                    </div>
                </div>

                <!-- Item Breakdown Table -->
                <div class="table-card" style="margin-bottom:14px;">
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr><th>Item</th><th>Count</th><th>Total</th><th>Credit</th><th>Net</th></tr>
                            </thead>
                            <tbody id="salesSummaryBody">
                                <tr class="empty-row"><td colspan="5"><div class="empty-state"><i class="fas fa-chart-bar"></i><p>No sales data</p></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Recent Sales Table -->
                <div class="table-card">
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr><th>Item</th><th>Customer</th><th>Total</th><th>Date</th><th></th></tr>
                            </thead>
                            <tbody id="salesTableBody">
                                <tr class="empty-row"><td colspan="5"><div class="empty-state"><i class="fas fa-shopping-cart"></i><p>No sales yet</p><small>Tap New Sale to get started</small></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Expenses -->
            <div id="expensesTab" class="tab-content">
                <div class="page-header-row">
                    <div>
                        <h2 style="font-size:22px;font-weight:800;">Expenses</h2>
                        <p style="font-size:13px;color:var(--text-2);">Track your spending</p>
                    </div>
                    <button class="btn btn-red" onclick="openExpenseModal()"><i class="fas fa-plus"></i> New Expense</button>
                </div>
                <div class="table-card">
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr><th>Category</th><th>Description</th><th>Amount</th><th>Date</th><th></th></tr>
                            </thead>
                            <tbody id="expensesTableBody">
                                <tr class="empty-row"><td colspan="5"><div class="empty-state"><i class="fas fa-receipt"></i><p>No expenses yet</p></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Credits -->
            <div id="creditsTab" class="tab-content">
                <div class="page-header">
                    <h2>Credits</h2>
                    <p>Pending payments from customers</p>
                </div>
                <div class="credit-summary">
                    <div class="cs-label">Total Pending</div>
                    <div class="cs-value" id="totalPending">$0</div>
                </div>
                <div class="table-card">
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr><th>Item</th><th>Customer</th><th>Owed</th><th>Date</th><th></th></tr>
                            </thead>
                            <tbody id="creditsTableBody">
                                <tr class="empty-row"><td colspan="5"><div class="empty-state"><i class="fas fa-check-circle" style="color:var(--green)"></i><p>No pending credits</p></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Reports -->
            <div id="reportsTab" class="tab-content">
                <div class="page-header">
                    <h2>Reports</h2>
                    <p>Profit &amp; loss overview</p>
                </div>
                <div class="report-type-grid">
                    <button class="report-type-btn b-blue" onclick="loadReport('daily')">
                        <i class="fas fa-sun"></i>Daily
                    </button>
                    <button class="report-type-btn b-green" onclick="loadReport('weekly')">
                        <i class="fas fa-calendar-week"></i>Weekly
                    </button>
                    <button class="report-type-btn b-purple" onclick="loadReport('monthly')">
                        <i class="fas fa-calendar-alt"></i>Monthly
                    </button>
                </div>
                <div class="card" id="reportContent" style="padding:24px;">
                    <div class="empty-state">
                        <i class="fas fa-chart-pie"></i>
                        <p>Select a period above</p>
                        <small>Daily, weekly, or monthly breakdown</small>
                    </div>
                </div>
            </div>

            <!-- Calendar -->
            <div id="calendarTab" class="tab-content">
                <div class="page-header">
                    <h2>Calendar</h2>
                    <p>Revenue &amp; expenses by date</p>
                </div>
                <div class="card" style="padding:16px;">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

        <!-- Bottom nav -->
        <nav class="bottom-nav">
            <div class="bottom-nav-inner">
                <button class="bnav-item active" id="bnav-dashboard" onclick="switchTab('dashboard')">
                    <i class="fas fa-th-large"></i><span>Home</span>
                </button>
                <button class="bnav-item" id="bnav-sales" onclick="switchTab('sales')">
                    <i class="fas fa-shopping-cart"></i><span>Sales</span>
                </button>
                <button class="bnav-item" id="bnav-expenses" onclick="switchTab('expenses')">
                    <i class="fas fa-receipt"></i><span>Expenses</span>
                </button>
                <button class="bnav-item" id="bnav-credits" onclick="switchTab('credits')">
                    <i class="fas fa-hand-holding-usd"></i><span>Credits</span>
                </button>
                <button class="bnav-item" id="bnav-reports" onclick="switchTab('reports')">
                    <i class="fas fa-chart-bar"></i><span>Reports</span>
                </button>
                <button class="bnav-item" id="bnav-calendar" onclick="switchTab('calendar')">
                    <i class="fas fa-calendar-alt"></i><span>Calendar</span>
                </button>
            </div>
        </nav>
    </div>

    <!-- ═══ SALE MODAL ═══ -->
    <div id="saleModal" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-plus-circle" style="color:var(--blue);margin-right:10px"></i>New Sale</h3>
                <button class="modal-close" onclick="closeSaleModal()"><i class="fas fa-times"></i></button>
            </div>
            <form id="saleForm">
                <input type="hidden" id="saleEditId">
                <div class="form-group">
                    <label>Item *</label>
                    <div class="ac-wrap">
                        <input type="text" id="saleItem" required placeholder="Type to search items…" oninput="autocompleteItems(this)">
                        <div id="autocompleteList" class="ac-list"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Customer Name <span style="font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></label>
                    <input type="text" id="customerName" placeholder="e.g. John Doe">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Quantity</label>
                        <input type="number" id="saleQuantity" value="1" required min="1">
                    </div>
                    <div class="form-group">
                        <label>Unit Price</label>
                        <input type="number" id="salePrice" step="0.01" required placeholder="0.00">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Credit (unpaid)</label>
                        <input type="number" id="saleCredit" step="0.01" value="0" placeholder="0.00">
                    </div>
                    <div class="form-group">
                        <label>Date</label>
                        <input type="date" id="saleDate">
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-blue"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="btn btn-outline" onclick="closeSaleModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══ EXPENSE MODAL ═══ -->
    <div id="expenseModal" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-plus-circle" style="color:var(--red);margin-right:10px"></i>New Expense</h3>
                <button class="modal-close" onclick="closeExpenseModal()"><i class="fas fa-times"></i></button>
            </div>
            <form id="expenseForm">
                <input type="hidden" id="expenseEditId">
                <div class="form-group">
                    <label>Category *</label>
                    <div class="ac-wrap">
                        <input type="text" id="expenseCategory" required placeholder="Type or create category…" oninput="autocompleteCategories(this)">
                        <div id="categoryAutocompleteList" class="ac-list"></div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Amount *</label>
                        <input type="number" id="expenseAmount" step="0.01" required placeholder="0.00">
                    </div>
                    <div class="form-group">
                        <label>Date</label>
                        <input type="date" id="expenseDate">
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" id="expenseDescription" placeholder="Optional note…">
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-red"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="btn btn-outline" onclick="closeExpenseModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══ DELETE MODAL ═══ -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal" style="max-width:360px;">
            <div class="delete-modal">
                <div class="del-icon"><i class="fas fa-trash"></i></div>
                <h3>Delete Record?</h3>
                <p>This cannot be undone.</p>
                <div class="form-actions">
                    <button class="btn btn-red" onclick="confirmDelete()"><i class="fas fa-trash"></i> Delete</button>
                    <button class="btn btn-outline" onclick="closeDeleteModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ SCRIPTS (load order matters!) ═══ -->
    <script src="/static/js/api.js"></script>
    <script src="/static/js/navigation.js"></script>
    <script src="/static/js/autocomplete.js"></script>
    <script src="/static/js/dashboard.js"></script>
    <script src="/static/js/sales.js"></script>
    <script src="/static/js/expenses.js"></script>
    <script src="/static/js/credits.js"></script>
    <script src="/static/js/reports.js"></script>
    <script src="/static/js/calendar.js"></script>
    <script src="/static/js/auth.js"></script>
    <script src="/static/js/main.js"></script>
</body>
</html>
