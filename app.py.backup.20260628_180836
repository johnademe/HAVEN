    cur.execute("""
        SELECT company_id FROM user_companies
        WHERE user_id = %s AND role = 'admin'
    """, (session['user_id'],))
    admin_companies = cur.fetchall()

    if not admin_companies:
        conn.close()
        return jsonify({"error": "Admin access required"}), 403

    company_ids = [company['company_id'] for company in admin_companies]

    cur.execute("""
        SELECT
            c.id as company_id,
            c.company_name,
            COALESCE(SUM(s.total), 0) as total_revenue,
            COALESCE(SUM(s.credit), 0) as total_credit,
            COUNT(DISTINCT s.id) as transaction_count,
            COALESCE(SUM(e.amount), 0) as total_expenses,
            COUNT(DISTINCT e.id) as expense_count
        FROM companies c
        LEFT JOIN sales s ON c.id = s.company_id
        LEFT JOIN expenses e ON c.id = e.company_id
        WHERE c.id = ANY(%s)
        GROUP BY c.id, c.company_name
        ORDER BY total_revenue DESC
    """, (company_ids,))
    performance = cur.fetchall()

    conn.close()
    return jsonify(performance)

