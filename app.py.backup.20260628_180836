@app.route('/api/sale', methods=['POST'])
@login_required
def add_sale():
    data = request.json
    conn = get_db()
    cur = conn.cursor()

    total = data['quantity'] * data['price']
    credit = data.get('credit', 0)

    if credit > total:
        return jsonify({"error": "Credit cannot exceed total amount"}), 400

    cur.execute("""
        INSERT INTO sales (item, quantity, price, total, credit, sale_date, company_id, created_by)
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
        RETURNING id
    """, (
        data['item'],
        data['quantity'],
        data['price'],
        total,
        credit,
        data.get('sale_date', datetime.now().strftime("%Y-%m-%d")),
        session['company_id'],
        session['user_id']
    ))
    sale_id = cur.fetchone()[0]

    cur.execute("""
        INSERT INTO items (item_name, default_price, usage_count, last_used, company_id)
        VALUES (%s, %s, 1, CURRENT_DATE, %s)
        ON CONFLICT (item_name, company_id) DO UPDATE SET
            usage_count = items.usage_count + 1,
            default_price = COALESCE(EXCLUDED.default_price, items.default_price),
            last_used = CURRENT_DATE
    """, (data['item'], data['price'], session['company_id']))

    if credit > 0:
        cur.execute("""
            INSERT INTO credits (sale_id, amount, status, due_date, company_id)
            VALUES (%s, %s, 'pending', %s, %s)
        """, (
            sale_id,
            credit,
            data.get('due_date', (datetime.now() + timedelta(days=30)).strftime("%Y-%m-%d")),
            session['company_id']
        ))

    conn.commit()
    conn.close()
    return jsonify({
        "id": sale_id,
        "total": total,
        "credit": credit,
        "net": total - credit
    })

@app.route('/api/sale/<int:sale_id>', methods=['PUT', 'DELETE'])
@login_required
def update_sale(sale_id):
    conn = get_db()
    cur = conn.cursor()

    cur.execute("SELECT company_id FROM sales WHERE id = %s", (sale_id,))
    sale = cur.fetchone()
    if not sale or sale[0] != session['company_id']:
        conn.close()
        return jsonify({"error": "Sale not found or access denied"}), 404

    if request.method == 'DELETE':
        cur.execute("DELETE FROM credits WHERE sale_id = %s", (sale_id,))
        cur.execute("DELETE FROM sales WHERE id = %s RETURNING id", (sale_id,))
        deleted = cur.fetchone()
        conn.commit()
        conn.close()
        if deleted:
            return jsonify({"status": "deleted"})
        return jsonify({"error": "Not found"}), 404

    data = request.json
    total = data['quantity'] * data['price']
    credit = data.get('credit', 0)

    if credit > total:
        conn.close()
        return jsonify({"error": "Credit cannot exceed total amount"}), 400

    cur.execute("""
        UPDATE sales
        SET item = %s, quantity = %s, price = %s, total = %s, credit = %s, sale_date = %s
        WHERE id = %s RETURNING id
    """, (data['item'], data['quantity'], data['price'], total, credit, data.get('sale_date'), sale_id))
    updated = cur.fetchone()

    if credit > 0:
        cur.execute("""
            INSERT INTO credits (sale_id, amount, status, due_date, company_id)
            VALUES (%s, %s, 'pending', %s, %s)
            ON CONFLICT (sale_id) DO UPDATE SET
                amount = EXCLUDED.amount,
                due_date = EXCLUDED.due_date,
                status = 'pending'
        """, (sale_id, credit, data.get('due_date', (datetime.now() + timedelta(days=30)).strftime("%Y-%m-%d")), session['company_id']))
    else:
        cur.execute("DELETE FROM credits WHERE sale_id = %s", (sale_id,))

    conn.commit()
    conn.close()
    if updated:
        return jsonify({"status": "updated", "id": sale_id, "total": total, "credit": credit})
    return jsonify({"error": "Not found"}), 404

