@app.route('/api/companies', methods=['GET', 'POST'])
@login_required
def companies():
    conn = get_db()
    cur = conn.cursor(cursor_factory=RealDictCursor)

    if request.method == 'POST':
        data = request.json
        company_name = data.get('company_name')
        if not company_name:
            return jsonify({"error": "Company name required"}), 400

        cur.execute("""
            INSERT INTO companies (company_name, created_by, created_at)
            VALUES (%s, %s, CURRENT_TIMESTAMP)
            RETURNING id
        """, (company_name, session['user_id']))
        company_id = cur.fetchone()['id']

        cur.execute("""
            INSERT INTO user_companies (user_id, company_id, role)
            VALUES (%s, %s, 'admin')
        """, (session['user_id'], company_id))
        conn.commit()
        conn.close()
        return jsonify({
            "success": True,
            "company_id": company_id,
            "company_name": company_name
        })

    cur.execute("""
        SELECT c.id, c.company_name, uc.role,
               (SELECT COUNT(*) FROM user_companies WHERE company_id = c.id) as member_count,
               (SELECT COUNT(*) FROM sales WHERE company_id = c.id) as total_sales,
               (SELECT COALESCE(SUM(total - credit), 0) FROM sales WHERE company_id = c.id) as total_revenue
        FROM companies c
        JOIN user_companies uc ON c.id = uc.company_id
        WHERE uc.user_id = %s
        ORDER BY c.company_name
    """, (session['user_id'],))
    companies = cur.fetchall()
    conn.close()
    return jsonify(companies)

@app.route('/api/companies/<int:company_id>', methods=['GET', 'PUT', 'DELETE'])
@login_required
def manage_company(company_id):
    conn = get_db()
    cur = conn.cursor(cursor_factory=RealDictCursor)

    cur.execute("""
        SELECT role FROM user_companies
        WHERE user_id = %s AND company_id = %s
    """, (session['user_id'], company_id))
    user_company = cur.fetchone()

    if not user_company:
        conn.close()
        return jsonify({"error": "Access denied"}), 403

    if request.method == 'DELETE':
        if user_company['role'] != 'admin':
            conn.close()
            return jsonify({"error": "Only admins can delete companies"}), 403

        cur.execute("DELETE FROM companies WHERE id = %s RETURNING id", (company_id,))
        deleted = cur.fetchone()
        conn.commit()
        conn.close()
        if deleted:
            return jsonify({"success": True})
        return jsonify({"error": "Company not found"}), 404

    if request.method == 'PUT':
        if user_company['role'] != 'admin':
            conn.close()
            return jsonify({"error": "Only admins can update company"}), 403

        data = request.json
        company_name = data.get('company_name')
        if company_name:
            cur.execute("""
                UPDATE companies SET company_name = %s
                WHERE id = %s RETURNING id
            """, (company_name, company_id))
            conn.commit()

        user_id = data.get('user_id')
        new_role = data.get('role')
        if user_id and new_role in ['admin', 'member', 'viewer']:
            cur.execute("""
                UPDATE user_companies SET role = %s
                WHERE user_id = %s AND company_id = %s
            """, (new_role, user_id, company_id))
            conn.commit()

        conn.close()
        return jsonify({"success": True})

    cur.execute("""
        SELECT c.*,
               COUNT(DISTINCT uc.user_id) as member_count,
               COUNT(DISTINCT s.id) as transaction_count
        FROM companies c
        LEFT JOIN user_companies uc ON c.id = uc.company_id
        LEFT JOIN sales s ON c.id = s.company_id
        WHERE c.id = %s
        GROUP BY c.id
    """, (company_id,))
    company = cur.fetchone()
    if not company:
        conn.close()
        return jsonify({"error": "Company not found"}), 404

    cur.execute("""
        SELECT u.id, u.username, u.email, u.full_name, uc.role, uc.joined_at
        FROM user_companies uc
        JOIN users u ON uc.user_id = u.id
        WHERE uc.company_id = %s
        ORDER BY uc.role, u.username
    """, (company_id,))
    company['members'] = cur.fetchall()
    conn.close()
    return jsonify(company)

