@app.route('/api/expenses', methods=['GET', 'POST'])
@login_required
def expenses():
    conn = get_db()
    cur = conn.cursor(cursor_factory=RealDictCursor)

    if request.method == 'POST':
        data = request.json
        required = ['category', 'amount', 'description']
        for field in required:
            if not data.get(field):
                return jsonify({"error": f"{field} is required"}), 400

        cur.execute("""
            INSERT INTO expenses (
                category, amount, description, expense_date,
                company_id, created_by, payment_method, receipt_number
            )
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
            RETURNING id
        """, (
            data['category'],
            data['amount'],
            data['description'],
            data.get('expense_date', datetime.now().strftime("%Y-%m-%d")),
            session['company_id'],
            session['user_id'],
            data.get('payment_method', 'cash'),
            data.get('receipt_number')
        ))
        expense_id = cur.fetchone()['id']
        conn.commit()
        conn.close()
        return jsonify({
            "success": True,
            "id": expense_id
        })

    category = request.args.get('category')
    start_date = request.args.get('start_date')
    end_date = request.args.get('end_date')
    limit = request.args.get('limit', 100, type=int)

    query = """
        SELECT id, category, amount, description, expense_date,
               payment_method, receipt_number, created_at
        FROM expenses
        WHERE company_id = %s
    """
    params = [session['company_id']]

    if category:
        query += " AND category = %s"
        params.append(category)

    if start_date:
        query += " AND expense_date >= %s"
        params.append(start_date)

    if end_date:
        query += " AND expense_date <= %s"
        params.append(end_date)

    query += " ORDER BY expense_date DESC LIMIT %s"
    params.append(limit)

    cur.execute(query, params)
    expenses = cur.fetchall()

    cur.execute("""
        SELECT
            COALESCE(SUM(amount), 0) as total_expenses,
            COUNT(*) as expense_count,
            COALESCE(AVG(amount), 0) as average_expense
        FROM expenses
        WHERE company_id = %s
    """, (session['company_id'],))
    summary = cur.fetchone()

    cur.execute("""
        SELECT
            category,
            COUNT(*) as count,
            COALESCE(SUM(amount), 0) as total,
            COALESCE(AVG(amount), 0) as average
        FROM expenses
        WHERE company_id = %s
        GROUP BY category
        ORDER BY total DESC
    """, (session['company_id'],))
    category_summary = cur.fetchall()

    conn.close()
    return jsonify({
        "expenses": expenses,
        "summary": summary,
        "category_summary": category_summary
    })

