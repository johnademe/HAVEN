    expense = cur.fetchone()
    if not expense or expense[0] != session['company_id']:
        conn.close()
        return jsonify({"error": "Expense not found or access denied"}), 404

    if request.method == 'DELETE':
        cur.execute("DELETE FROM expenses WHERE id = %s RETURNING id", (expense_id,))
        deleted = cur.fetchone()
        conn.commit()
        conn.close()
        if deleted:
            return jsonify({"status": "deleted"})
        return jsonify({"error": "Not found"}), 404

    data = request.json
    cur.execute("""
        UPDATE expenses
        SET category = %s, amount = %s, description = %s,
            expense_date = %s, payment_method = %s, receipt_number = %s
        WHERE id = %s RETURNING id
    """, (
        data['category'],
        data['amount'],
        data['description'],
        data.get('expense_date'),
        data.get('payment_method'),
        data.get('receipt_number'),
        expense_id
    ))
    updated = cur.fetchone()
    conn.commit()
    conn.close()
    if updated:
        return jsonify({"status": "updated", "id": expense_id})
    return jsonify({"error": "Not found"}), 404

