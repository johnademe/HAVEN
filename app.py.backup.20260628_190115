@app.route('/api/calendar-data', methods=['GET'])
@login_required
def calendar_data():
    try:
        start = request.args.get('start')
        end = request.args.get('end')
        
        if not start or not end:
            return jsonify({"error": "Start and end dates required"}), 400
        
        conn = get_db()
        cur = conn.cursor(cursor_factory=RealDictCursor)
        
        # Get sales by date
        cur.execute("""
            SELECT 
                sale_date as date,
                COALESCE(SUM(total), 0) as revenue,
                COALESCE(SUM(credit), 0) as credit,
                COALESCE(SUM(total - credit), 0) as net_revenue,
                COUNT(*) as sales_count
            FROM sales
            WHERE sale_date BETWEEN %s AND %s AND company_id = 1
            GROUP BY sale_date
            ORDER BY sale_date
        """, (start, end))
        sales_by_date = cur.fetchall()
        
        # Get expenses by date
        cur.execute("""
            SELECT 
                expense_date as date,
                COALESCE(SUM(amount), 0) as expenses,
                COUNT(*) as expense_count
            FROM expenses
            WHERE expense_date BETWEEN %s AND %s AND company_id = 1
            GROUP BY expense_date
            ORDER BY expense_date
        """, (start, end))
        expenses_by_date = cur.fetchall()
        
        conn.close()
        
        # Combine data
        result = {}
        for row in sales_by_date:
            date_str = row['date'].strftime('%Y-%m-%d')
            result[date_str] = {
                'revenue': float(row['revenue']),
                'credit': float(row['credit']),
                'net_revenue': float(row['net_revenue']),
                'sales_count': row['sales_count'],
                'expenses': 0,
                'expense_count': 0,
                'profit': float(row['net_revenue'])
            }
        
        for row in expenses_by_date:
            date_str = row['date'].strftime('%Y-%m-%d')
            if date_str in result:
                result[date_str]['expenses'] = float(row['expenses'])
                result[date_str]['expense_count'] = row['expense_count']
                result[date_str]['profit'] = result[date_str]['net_revenue'] - float(row['expenses'])
            else:
                result[date_str] = {
                    'revenue': 0,
                    'credit': 0,
                    'net_revenue': 0,
                    'sales_count': 0,
                    'expenses': float(row['expenses']),
                    'expense_count': row['expense_count'],
                    'profit': -float(row['expenses'])
                }
        
        return jsonify(result)
    except Exception as e:
        print(f"Calendar data error: {e}")
        return jsonify({"error": str(e)}), 500
